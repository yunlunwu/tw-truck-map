{
  "rewrites": [
    {
      "source": "/api/ntpc/:path*",
      "destination": "https://data.ntpc.gov.tw/:path*"
    },
    {
      "source": "/api/taipei/:path*",
      "destination": "https://data.taipei/:path*"
    },
    {
      "source": "/api/geocode/:path*",
      "destination": "https://nominatim.openstreetmap.org/:path*"
    }
  ]
}
